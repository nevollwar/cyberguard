# Общие настройки приложения
APP_NAME=CyberGuard
APP_ENV=development
LOG_LEVEL=INFO

# Хранилище и пути
SQLITE_DB_PATH=storage/cyberguard.db
MODELS_DIR=models
DATA_RESULTS_DIR=data/results

# Настройки FastAPI
API_HOST=127.0.0.1
API_PORT=8000
API_ACCESS_TOKEN=replace-with-strong-random-api-key
API_BASE_URL=http://127.0.0.1:8000

# Настройки Telegram-бота
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
# Список разрешённых Telegram user_id через запятую (оставьте пустым, если ограничение отключено)
TELEGRAM_ALLOWED_USER_IDS=