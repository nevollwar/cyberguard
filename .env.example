# Общие настройки приложения
APP_NAME=CyberGuard
APP_ENV=development
LOG_LEVEL=INFO

# Хранилище и пути
SQLITE_DB_PATH=storage/cyberguard.db
MODELS_DIR=models
DATA_RESULTS_DIR=data/results

# Настройки FastAPI
API_HOST=127.0.0.1
API_PORT=8000
API_ACCESS_TOKEN=cyberguard-secret-token-2026
API_BASE_URL=http://127.0.0.1:8000

# Настройки Telegram-бота
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
# Прокси для Telegram (если нужен, например: http://127.0.0.1:10809)
TELEGRAM_PROXY_URL=
# Список разрешённых Telegram user_id через запятую (если пусто — доступ открыт всем)
TELEGRAM_ALLOWED_USER_IDS=